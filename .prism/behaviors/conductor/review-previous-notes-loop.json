{
  "id": "review-previous-notes-loop",
  "fsmId": "pipeline",
  "botId": "conductor",
  "name": "Review previous notes (Gather-Judge-Render-Check, task cd33263f)",
  "version": 4,
  "steps": [
    {
      "id": "gather",
      "kind": "http-callback",
      "url": "${prismBackendUrl}/api/workflows/steps/premise-gather?project=${project}",
      "body": "{\"task_id\": \"${taskId}\"}",
      "timeoutSeconds": 30
    },
    {
      "id": "loop",
      "kind": "http-callback",
      "url": "${prismBackendUrl}/api/workflows/steps/premise-judge?project=${project}",
      "body": "{\"model\": \"haiku\", \"max_budget_usd\": 0.5, \"max_turns\": 2, \"task_id\": \"${taskId}\"}",
      "timeoutSeconds": 120
    },
    {
      "id": "render",
      "kind": "http-callback",
      "url": "${prismBackendUrl}/api/workflows/steps/premise-render?project=${project}",
      "body": "{\"task_id\": \"${taskId}\"}",
      "timeoutSeconds": 30
    },
    {
      "id": "check",
      "kind": "http-callback",
      "url": "${prismBackendUrl}/api/workflows/steps/premise-citation-check?project=${project}",
      "body": "{\"task_id\": \"${taskId}\"}",
      "timeoutSeconds": 30
    },
    {
      "id": "text-challenge",
      "kind": "http-callback",
      "url": "${prismBackendUrl}/api/workflows/steps/text-challenge?project=${project}",
      "body": "{\"task_id\": \"${taskId}\", \"step_id\": \"review_previous_notes\"}",
      "timeoutSeconds": 60
    }
  ]
}
