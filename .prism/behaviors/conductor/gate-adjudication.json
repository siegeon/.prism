{
  "id": "gate-adjudication",
  "fsmId": "pipeline",
  "botId": "conductor",
  "name": "Adjudicate a gate",
  "version": 1,
  "steps": [
    {
      "id": "codified",
      "kind": "http-callback",
      "url": "${prismBackendUrl}/api/workflows/steps/gate-adjudication?project=${project}",
      "body": "{\"task_id\": \"${taskId}\", \"stage\": \"codified\"}",
      "timeoutSeconds": 60
    },
    {
      "id": "infer",
      "kind": "http-callback",
      "url": "${prismBackendUrl}/api/workflows/steps/gate-adjudication?project=${project}",
      "body": "{\"task_id\": \"${taskId}\", \"stage\": \"infer\"}",
      "timeoutSeconds": 420
    }
  ]
}
