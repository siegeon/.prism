{
  "id": "plan-gate-check",
  "fsmId": "pipeline",
  "botId": "conductor",
  "name": "Check plan coverage",
  "version": 6,
  "steps": [
    {
      "id": "already_shipped",
      "kind": "http-callback",
      "url": "${prismBackendUrl}/api/workflows/steps/plan-gate-check-one?project=${project}",
      "body": "{\"task_id\": \"${taskId}\", \"check\": \"already_shipped\"}",
      "timeoutSeconds": 300
    },
    {
      "id": "rubric",
      "kind": "http-callback",
      "url": "${prismBackendUrl}/api/workflows/steps/plan-gate-check?project=${project}",
      "body": "{\"plan_doc\": ${planDoc}, \"plan_diagram\": ${planDiagram}, \"task_id\": \"${taskId}\"}",
      "timeoutSeconds": 30
    },
    {
      "id": "absent_file_claim",
      "kind": "http-callback",
      "url": "${prismBackendUrl}/api/workflows/steps/plan-gate-check-one?project=${project}",
      "body": "{\"task_id\": \"${taskId}\", \"check\": \"absent_file_claim\"}",
      "timeoutSeconds": 60
    },
    {
      "id": "stop_if_pinned",
      "kind": "http-callback",
      "url": "${prismBackendUrl}/api/workflows/steps/plan-gate-check-one?project=${project}",
      "body": "{\"task_id\": \"${taskId}\", \"check\": \"stop_if_pinned\"}",
      "timeoutSeconds": 30
    },
    {
      "id": "already_green_ac",
      "kind": "http-callback",
      "url": "${prismBackendUrl}/api/workflows/steps/plan-gate-check-one?project=${project}",
      "body": "{\"task_id\": \"${taskId}\", \"check\": \"already_green_ac\"}",
      "timeoutSeconds": 300
    },
    {
      "id": "manual_reject_stands",
      "kind": "http-callback",
      "url": "${prismBackendUrl}/api/workflows/steps/plan-gate-check-one?project=${project}",
      "body": "{\"task_id\": \"${taskId}\", \"check\": \"manual_reject_stands\"}",
      "timeoutSeconds": 30
    },
    {
      "id": "plan_diagram_parses",
      "kind": "http-callback",
      "url": "${prismBackendUrl}/api/workflows/steps/plan-gate-check-one?project=${project}",
      "body": "{\"task_id\": \"${taskId}\", \"check\": \"plan_diagram_parses\"}",
      "timeoutSeconds": 30
    },
    {
      "id": "infer",
      "kind": "http-callback",
      "url": "${prismBackendUrl}/api/workflows/steps/gate-adjudication?project=${project}",
      "body": "{\"task_id\": \"${taskId}\", \"stage\": \"infer\"}",
      "timeoutSeconds": 420
    }
  ]
}
