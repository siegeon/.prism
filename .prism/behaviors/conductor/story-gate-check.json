{
  "id": "story-gate-check",
  "fsmId": "pipeline",
  "botId": "conductor",
  "name": "Check story completeness",
  "version": 2,
  "steps": [
    {
      "id": "evaluate",
      "kind": "http-callback",
      "url": "${prismBackendUrl}/api/workflows/steps/story-gate-check?project=${project}",
      "body": "{\"story_doc\": ${storyDoc}, \"task_id\": \"${taskId}\"}",
      "timeoutSeconds": 30
    },
    {
      "id": "infer",
      "kind": "http-callback",
      "url": "${prismBackendUrl}/api/workflows/steps/gate-adjudication?project=${project}",
      "body": "{\"task_id\": \"${taskId}\", \"stage\": \"infer\"}",
      "timeoutSeconds": 420
    }
  ]
}
