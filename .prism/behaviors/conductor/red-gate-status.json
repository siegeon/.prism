{
  "id": "red-gate-status",
  "fsmId": "pipeline",
  "botId": "conductor",
  "name": "Red gate evidence status",
  "version": 2,
  "steps": [
    {
      "id": "status",
      "kind": "http-callback",
      "url": "${prismBackendUrl}/api/workflows/steps/red-gate-status?project=${project}",
      "body": "{\"task_id\": \"${taskId}\"}",
      "timeoutSeconds": 30
    },
    {
      "id": "infer",
      "kind": "http-callback",
      "url": "${prismBackendUrl}/api/workflows/steps/gate-adjudication?project=${project}",
      "body": "{\"task_id\": \"${taskId}\", \"stage\": \"infer\"}",
      "timeoutSeconds": 420
    }
  ]
}
