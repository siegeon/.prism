{
  "id": "write-failing-tests-loop",
  "fsmId": "pipeline",
  "botId": "conductor",
  "name": "Write failing tests (Route-Observe-Reason-Write-Run-Commit)",
  "version": 14,
  "steps": [
    {
      "id": "route",
      "kind": "http-callback",
      "url": "${prismBackendUrl}/api/workflows/steps/oracle-route-check?project=${project}",
      "body": "{\"task_id\": \"${taskId}\"}",
      "timeoutSeconds": 30
    },
    {
      "id": "gather",
      "kind": "http-callback",
      "url": "${prismBackendUrl}/api/workflows/steps/context-enrich?project=${project}",
      "body": "{\"workflow_id\": \"write-failing-tests-loop\", \"instance_id\": \"${taskId}\", \"step_id\": \"gather\", \"persona\": \"qa\"}",
      "timeoutSeconds": 30
    },
    {
      "id": "recall",
      "kind": "http-callback",
      "url": "${prismBackendUrl}/api/workflows/steps/refusal-recall?project=${project}",
      "body": "{\"task_id\": \"${taskId}\"}",
      "timeoutSeconds": 30
    },
    {
      "id": "scaffold",
      "kind": "http-callback",
      "url": "${prismBackendUrl}/api/workflows/steps/test-scaffold?project=${project}",
      "body": "{\"task_id\": \"${taskId}\"}",
      "timeoutSeconds": 30
    },
    {
      "id": "targets",
      "kind": "http-callback",
      "url": "${prismBackendUrl}/api/workflows/steps/red-targets-from-acs?project=${project}",
      "body": "{\"task_id\": \"${taskId}\", \"verify\": \"${verify}\", \"plan_doc\": \"${planDoc}\"}",
      "timeoutSeconds": 30
    },
    {
      "id": "pack",
      "kind": "http-callback",
      "url": "${prismBackendUrl}/api/workflows/steps/red-context-pack?project=${project}",
      "body": "{\"task_id\": \"${taskId}\", \"budget_chars\": 2000, \"verify\": \"${verify}\"}",
      "timeoutSeconds": 30
    },
    {
      "id": "compose",
      "kind": "http-callback",
      "url": "${prismBackendUrl}/api/workflows/steps/red-prompt-compose?project=${project}",
      "body": "{\"task_id\": \"${taskId}\", \"task_hint\": \"${taskHint}\", \"targets_block\": \"${targetsBlock}\", \"context_block\": \"${contextBlock}\", \"scaffold_block\": \"${scaffoldBlock}\", \"refusal_block\": \"${refusalBlock}\", \"oracle\": \"${oracle}\"}",
      "timeoutSeconds": 30
    },
    {
      "id": "loop",
      "kind": "http-callback",
      "url": "${prismBackendUrl}/api/workflows/steps/reason-loop?project=${project}",
      "body": "{\"persona\": \"qa\", \"prompt\": \"${prompt}\", \"json_schema\": {\"type\": \"object\", \"properties\": {\"test_bodies\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"name\": {\"type\": \"string\"}, \"body\": {\"type\": \"string\"}}, \"required\": [\"name\", \"body\"]}}, \"expected_failure_reason\": {\"type\": \"string\"}}, \"required\": [\"test_bodies\", \"expected_failure_reason\"]}, \"rubric\": \"test_drafted\", \"model\": \"haiku\", \"max_budget_usd\": 0.5, \"max_turns\": 4, \"task_id\": \"${taskId}\"}",
      "timeoutSeconds": 120
    },
    {
      "id": "write",
      "kind": "http-callback",
      "url": "${prismBackendUrl}/api/workflows/steps/write-test-file?project=${project}",
      "body": "{\"task_id\": \"${taskId}\", \"test_file_path\": \"${testFilePath}\", \"test_code\": \"${testCode}\"}",
      "timeoutSeconds": 30
    },
    {
      "id": "run",
      "kind": "http-callback",
      "url": "${prismBackendUrl}/api/workflows/steps/run-pinned-suite?project=${project}",
      "body": "{\"task_id\": \"${taskId}\", \"expected_rc\": 1, \"retry_prompt\": \"${prompt}\"}",
      "timeoutSeconds": 660
    },
    {
      "id": "commit",
      "kind": "http-callback",
      "url": "${prismBackendUrl}/api/workflows/steps/commit-tests-only?project=${project}",
      "body": "{\"task_id\": \"${taskId}\"}",
      "timeoutSeconds": 120
    }
  ]
}
