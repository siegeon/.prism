# Node modules. No trailing slash: a trailing-slash pattern matches
# directories only, never a symlink (git-scm.com/docs/gitignore), and
# task_workspace._link_web_node_modules links deps into a task worktree
# via a POSIX symlink on Linux - the trailing-slash form let that link
# leak into `git status --porcelain` as untracked (task 93cd2cf9, CI
# evidence PR #1282 run 31865514286).
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Environment variables
.env
.env.local
.env.*.local

# IDE and editor files
.vscode/
.idea/
.obsidian/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp
nul

# Build outputs
dist/
build/
out/

# Validation reports (generated by validate-docs.py)
docs/validation/

# Story tracking files (generated)
docs/stories/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# OS files
Thumbs.db
.DS_Store

# Personal configuration
*.local.yaml
*.local.json

# Jira credentials (never commit these!)
.jira-token
jira-config.local.yaml

# Testing
coverage/
.nyc_output/

# Claude Code temporary files
.claude-temp/
.claude/

# PRISM Context Memory (runtime files only, not vault)
.prism-memory.db
.prism-memory-log.txt
.prism-memory-api-log.txt
.prism-memory.db-shm
.prism-memory.db-wal
.prism-knowledge/

# Project-specific skills (not part of PRISM core)
skills/orca-*/

# Current story tracking (local state)
.prism-current-story.txt

# PRISM context cache (local runtime only)
.context/
!plugins/prism-devtools/templates/.context/
!plugins/prism-devtools/templates/.context/**

# Brain runtime databases and state
brain/
.prism/brain/
.prism/handoff.md
.prism/current_instruction.md
.prism/last_session_state.yaml
.prism/feedback-buffer.jsonl
.prism/graph-dirty
plugins/prism-devtools/tools/prism-cli/.prism/

# Benchmarks — runtime data, cloned fixtures, and results (scripts only in git)
benchmarks/data/
benchmarks/repos/
benchmarks/results/
benchmarks/.venv/
benchmarks/.venv-wsl/
services/bench-service/data-bench/
.prism/feedback-buffer.jsonl
services/prism-service/prism_service/web_dist/
services/prism-service/build/
services/prism-service/dist/
services/prism-service/*.egg-info/
.dev-data-verify/

# local dev/bench data stores (never commit)
.dev-data/
services/bench-service/data-bench-native/
