{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PRISM",
  "version": "0.1.0",
  "identifier": "studio.prism.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "PRISM",
        "url": "http://localhost:7778/",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/prism-service"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/siegeon/.prism/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4RDY1Nzg4OUE0MjEyQjIKUldTeUVrS2FpRmZXK0FtUTltWTZJSXdwMGV6Sm0vWUhFbk95bTNxay9HQjVKd0oycVRRdkdHYWkK"
    }
  }
}
